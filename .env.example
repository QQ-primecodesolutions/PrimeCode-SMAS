# Copy to .env.local for local testing of the login; set the real values in Vercel's
# Environment Variables (never commit them). Without AUTH_SECRET, local `pnpm dev` stays open.

# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=

# The founder's passphrase: 3-4 random words, 16+ characters (not "Name@Year").
# Changing it doesn't sign existing sessions out; rotate AUTH_SECRET for that.
ADMIN_PASSWORD=

# Login lockout counts (Upstash for Redis from the Vercel Marketplace sets these for you).
# Required in production; locally an in-memory store is used when they're empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
